# =============================================
# Raethingz .htaccess — Security & Rewrites
# =============================================

# Block direct access to sensitive directories
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny access to includes/ directory (PHP files only, no direct URL access)
  RewriteRule ^includes/ - [F,L]

  # Deny access to database/ directory
  RewriteRule ^database/ - [F,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to hidden files (e.g. .env, .git)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block PHP execution inside uploads/ folder
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 1 month"
  ExpiresByType image/png   "access plus 1 month"
  ExpiresByType image/webp  "access plus 1 month"
  ExpiresByType text/css    "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Set default charset
AddDefaultCharset UTF-8
